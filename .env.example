# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai 또는 fake(키 없이 가짜 응답)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ENV=local
# 팀 비밀번호. 비워 두면 아무도 입장할 수 없다
TEAM_PASSWORD=
DAILY_LIMIT=300

# Langfuse (두 키가 다 있을 때만 기록을 보낸다)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
